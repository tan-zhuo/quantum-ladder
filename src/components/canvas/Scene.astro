---
import { getLangFromPath, type Lang } from '@/i18n'
import BlochSphereScene from './BlochSphere/BlochSphereScene'
import WavefunctionScene from './Wavefunction/WavefunctionScene'
import HydrogenOrbitalScene from './HydrogenOrbital/HydrogenOrbitalScene'
import PotentialWellScene from './PotentialWell/PotentialWellScene'
import DoubleSlitScene from './DoubleSlit/DoubleSlitScene'
import TunnelingScene from './Tunneling/TunnelingScene'
import SternGerlachScene from './SternGerlach/SternGerlachScene'
import EntanglementScene from './Entanglement/EntanglementScene'
import SuperpositionScene from './Superposition/SuperpositionScene'
import DecoherenceScene from './Decoherence/DecoherenceScene'
import PathIntegralScene from './PathIntegral/PathIntegralScene'
import IdenticalParticlesScene from './IdenticalParticles/IdenticalParticlesScene'

/**
 * MDX 里嵌入 3D 场景的唯一入口：<Scene name="bloch-sphere" />
 *
 * 和 src/components/mdx/Sim.astro 同一个套路：client:* 指令要求组件在编译期
 * 是静态引用，所以这里必须逐个 if 而不是查表——从对象里取组件再挂 client:visible，
 * Astro 在编译期认不出它对应哪个模块，构建会报 NoMatchingImport。
 *
 * 一律用 client:visible：一个模块页可能有两三个场景，每个场景都是几十上百 KB 的
 * three.js 运行时 + 数万个顶点，滚到哪个才初始化哪个，首屏才不会被拖垮。
 */

export const SCENE_NAMES = [
  'bloch-sphere',
  'wavefunction',
  'hydrogen-orbital',
  'potential-well',
  'double-slit',
  'tunneling',
  'stern-gerlach',
  'entanglement',
  'superposition',
  'decoherence',
  'path-integral',
  'identical-particles',
] as const

export type SceneName = (typeof SCENE_NAMES)[number]

interface Props {
  name: SceneName
  /** 显式指定界面语言；不传就按路由判断 */
  lang?: Lang
}

/**
 * 语言默认从路由推断，这样 MDX 里只写 <Scene name="…" /> 就够了——
 * 中英两份内容用的是同一段写法，不必各写一遍带 lang 的版本。
 */
const base = import.meta.env.BASE_URL
const rel = Astro.url.pathname.startsWith(base)
  ? Astro.url.pathname.slice(base.length)
  : Astro.url.pathname
const lang: Lang = Astro.props.lang ?? getLangFromPath(rel)
const { name } = Astro.props

if (!SCENE_NAMES.includes(name)) {
  throw new Error(
    `未知的 3D 场景 "${name}"。可用的有：${SCENE_NAMES.join('、')}。` +
      `新增场景请在 src/components/canvas/Scene.astro 里登记。`,
  )
}
---

<div class="ql-canvas-host">
  {name === 'bloch-sphere' && <BlochSphereScene lang={lang} client:visible />}
  {name === 'wavefunction' && <WavefunctionScene lang={lang} client:visible />}
  {name === 'hydrogen-orbital' && <HydrogenOrbitalScene lang={lang} client:visible />}
  {name === 'potential-well' && <PotentialWellScene lang={lang} client:visible />}
  {name === 'double-slit' && <DoubleSlitScene lang={lang} client:visible />}
  {name === 'tunneling' && <TunnelingScene lang={lang} client:visible />}
  {name === 'stern-gerlach' && <SternGerlachScene lang={lang} client:visible />}
  {name === 'entanglement' && <EntanglementScene lang={lang} client:visible />}
  {name === 'superposition' && <SuperpositionScene lang={lang} client:visible />}
  {name === 'decoherence' && <DecoherenceScene lang={lang} client:visible />}
  {name === 'path-integral' && <PathIntegralScene lang={lang} client:visible />}
  {name === 'identical-particles' && <IdenticalParticlesScene lang={lang} client:visible />}
</div>

<noscript>
  <div
    class="my-8 rounded-xl border border-dashed border-[var(--border-strong)] bg-[var(--bg-subtle)] px-4 py-6 text-center text-[13.5px] text-[var(--text-muted)]"
  >
    这里是一个 3D 交互场景（{name}），需要启用 JavaScript 与 WebGL 才能运行。
  </div>
</noscript>
