---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getToc } from '@/lib/toc'
import { getLabModules, countScenes } from '@/lib/lab'
import { translator, localePath, DEFAULT_LANG, type Lang } from '@/i18n'

interface Props {
  lang?: Lang
}

const { lang = DEFAULT_LANG } = Astro.props
const t = translator(lang)
const toc = await getToc(lang)
const modules = await getLabModules(lang)
const sceneCount = await countScenes()
const base = import.meta.env.BASE_URL
const L = (p: string) => localePath(lang, p, base)

const allSections = toc.flatMap((c) => c.sections)
const doneSections = allSections.filter((s) => s.status === 'done')

/** 首屏推荐的五个核心场景：规格里的 Phase 1 */
const FEATURED = [
  {
    module: '05-spin',
    scene: 'Bloch 球',
    title: '在 Bloch 球上操作自旋态',
    desc: '球面上每一点对应一个纯态。可以施加磁场观察进动，沿任意轴测量观察投影，重复测量后比较统计频率与 Born 规则的预测。',
  },
  {
    module: '06-hydrogen',
    scene: '氢原子轨道',
    title: '氢原子的概率密度 |ψ|²',
    desc: '以六万次位置采样逐点显示概率分布。可以切换量子数 n、l、m，并对轨道做剖切以观察内部结构。',
  },
  {
    module: '03-bound-states',
    scene: '势阱与谐振子',
    title: '定态的时间演化',
    desc: '定态波函数的相位随时间旋转，|ψ|² 保持不变。图中同时给出能级、节点位置和阱壁外的指数衰减部分。',
  },
  {
    module: '01-double-slit',
    scene: '双缝干涉',
    title: '单粒子累积的干涉条纹',
    desc: '粒子逐个到达屏幕，起初分布看不出规律，数百个之后干涉条纹逐渐显现。在缝处加入路径探测器后，条纹消失。',
  },
  {
    module: '04-tunneling',
    scene: '隧道效应',
    title: '波包穿过势垒',
    desc: '实时数值求解含时薛定谔方程。能量低于势垒时，经典粒子被完全反射，波包则有一部分透射到势垒另一侧。',
  },
]

const PATHS = [
  {
    name: '初学者',
    desc: '按模块编号依次学习 01 → 04，建立波函数、定态和隧穿的基本图像。',
    route: ['00', '01', '02', '03', '04'],
    accent: 'var(--accent)',
  },
  {
    name: '正在修读量子力学课程',
    desc: '配合课程进度查看对应模块的图像，再回到推导。每个场景下方的「深入阅读」链接到相应教材小节。',
    route: ['03', '06', '05', '09', '11'],
    accent: 'var(--c-prob)',
  },
  {
    name: '侧重量子信息',
    desc: '略过连续谱和氢原子，集中学习二能级系统：Bloch 球、测量、纠缠、退相干。',
    route: ['05', '07', '08', '12'],
    accent: 'var(--c-energy)',
  },
]
---

<BaseLayout title={t('首页')} sidebar={false} lang={lang}>
  <div class="mx-auto w-full max-w-[1080px] px-5 py-12 lg:px-8 lg:py-16">
    <!-- ── Hero ─────────────────────────────────────────── -->
    <section class="mb-14">
      <p class="mb-3 font-mono text-[13px] tracking-wide text-[var(--accent-text)]">
        {t('交互式量子力学 · 中英双语 · 可离线使用')}
      </p>
      <h1 class="max-w-[20ch] text-[36px] leading-[1.15] font-bold tracking-tight sm:text-[46px]">
        {t('量子力学阶梯')}
      </h1>
      <p class="mt-5 max-w-[62ch] text-[17px] leading-relaxed text-[var(--text-muted)]">
        {
          t(
            '一套以交互演示为主线的量子力学入门与进阶材料。站内有 {0} 个 3D 场景，涵盖双缝干涉、势阱、隧穿、自旋、氢原子轨道和纠缠等内容，每个场景都可以调节参数、观察演化，并与配套教材中的推导相互对照。全部数值计算在浏览器中完成。',
            sceneCount,
          )
        }
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href={L('lab/05-spin/')}
          class="inline-flex items-center gap-2 rounded-lg bg-[var(--accent)] px-5 py-2.5 text-[14.5px] font-medium text-white transition-opacity hover:opacity-90"
        >
          {t('从 Bloch 球开始')}
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
        <a
          href={L('lab/')}
          class="inline-flex items-center gap-2 rounded-lg border border-[var(--border)] bg-[var(--bg-elevated)] px-4 py-2.5 text-[14.5px] text-[var(--text-muted)] transition-colors hover:border-[var(--border-strong)] hover:text-[var(--text)]"
        >
          {t('全部 {0} 个模块', modules.length)}
        </a>
        <a
          href={L('lab/00-intro/')}
          class="text-[14px] text-[var(--text-faint)] underline underline-offset-4 transition-colors hover:text-[var(--accent-text)]"
        >
          {t('使用说明')}
        </a>
      </div>

      <div id="ql-resume" class="mt-6 hidden">
        <a
          data-resume-link
          href={base}
          class="inline-flex items-center gap-2 rounded-lg border border-[var(--accent)]/35 bg-[var(--accent-soft)] px-3.5 py-2 text-[13.5px] text-[var(--accent-text)] transition-opacity hover:opacity-85"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M7 4l13 8-13 8z"></path>
          </svg>
          {t('继续上次：')}<span data-resume-label class="font-medium"></span>
        </a>
      </div>
    </section>

    <!-- ── Phase 1 场景 ─────────────────────────────────── -->
    <section class="mb-16">
      <div class="mb-4 flex items-baseline justify-between gap-3">
        <h2 class="text-[13px] font-semibold tracking-[0.12em] text-[var(--text-faint)] uppercase">
          {t('推荐场景')}
        </h2>
        <a href={`${base}lab/`} class="text-[13px] text-[var(--accent-text)] hover:underline">
          {t('全部模块 →')}
        </a>
      </div>

      <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          FEATURED.map((f, i) => (
            <li class={i === 0 ? 'sm:col-span-2 lg:col-span-1' : ''}>
              <a
                href={L(`lab/${f.module}/`)}
                class="group flex h-full flex-col rounded-xl border border-[var(--border)] bg-[var(--bg-elevated)] px-4 py-4 shadow-[var(--shadow-card)] transition-colors hover:border-[var(--accent)]/45"
              >
                <p class="mb-1.5 flex items-center gap-1.5 font-mono text-[11.5px] text-[var(--accent-text)]">
                  <span aria-hidden="true">◆</span>
                  {t(f.scene)}
                </p>
                <h3 class="text-[15.5px] font-semibold tracking-tight group-hover:text-[var(--accent-text)]">
                  {t(f.title)}
                </h3>
                <p class="mt-1.5 text-[13.5px] leading-relaxed text-[var(--text-muted)]">{t(f.desc)}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- ── 这个平台和别的有什么不同 ───────────────────────── -->
    <section class="mb-16 grid gap-4 sm:grid-cols-3">
      {
        [
          {
            t: '三维可视化',
            d: '适合用空间图像说明的内容尽量用三维呈现。场景支持旋转、缩放、剖切、时间演化和预设视角。',
          },
          {
            t: '实时数值计算',
            d: '本征值求解、split-operator 时间演化和蒙特卡洛采样均在浏览器中运行。读数区并列给出数值解与解析解，便于对照。',
          },
          {
            t: '图像与推导对照',
            d: '每个场景附有观察指南，说明应关注的现象和可调参数，并列出初学者常见的错误理解。',
          },
        ].map((x) => (
          <div class="rounded-xl border border-[var(--border)] px-4 py-3.5">
            <h3 class="text-[14.5px] font-semibold">{t(x.t)}</h3>
            <p class="mt-1.5 text-[13px] leading-relaxed text-[var(--text-muted)]">{t(x.d)}</p>
          </div>
        ))
      }
    </section>

    <!-- ── 学习路线 ─────────────────────────────────────── -->
    <section class="mb-16">
      <h2 class="mb-4 text-[13px] font-semibold tracking-[0.12em] text-[var(--text-faint)] uppercase">
        {t('学习路线')}
      </h2>
      <div class="grid gap-3 sm:grid-cols-3">
        {
          PATHS.map((p) => (
            <div class="flex flex-col rounded-xl border border-[var(--border)] bg-[var(--bg-elevated)] px-4 py-3.5">
              <h3 class="text-[15px] font-semibold" style={`color:${p.accent}`}>
                {t(p.name)}
              </h3>
              <p class="mt-1.5 flex-1 text-[13px] leading-relaxed text-[var(--text-muted)]">{t(p.desc)}</p>
              <div class="mt-3 flex flex-wrap items-center gap-1">
                {p.route.map((num, i) => {
                  const m = modules.find((x) => x.num === num)
                  return (
                    <>
                      {i > 0 && (
                        <span class="text-[10px] text-[var(--text-faint)]" aria-hidden="true">
                          →
                        </span>
                      )}
                      <a
                        href={m ? L(m.path) : L('lab/')}
                        title={m?.title}
                        class="rounded-md bg-[var(--bg-subtle)] px-1.5 py-0.5 font-mono text-[11px] text-[var(--text-muted)] transition-colors hover:text-[var(--accent-text)]"
                      >
                        {num}
                      </a>
                    </>
                  )
                })}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ── 教材部分 ─────────────────────────────────────── -->
    <section class="mb-16">
      <div class="rounded-xl border border-[var(--border)] bg-[var(--bg-subtle)] px-5 py-5">
        <h2 class="text-[16px] font-semibold">{t('配套教材')}</h2>
        <p class="mt-2 max-w-[68ch] text-[14px] leading-relaxed text-[var(--text-muted)]">
          {
            t(
              '完整的推导、习题和数值方法见教材部分，共 {0} 章 {1} 节，其中 {2} 节已定稿。每个模块页面底部都附有对应章节的链接。',
              toc.length,
              allSections.length,
              doneSections.length,
            )
          }

        </p>
        <div class="mt-4 flex flex-wrap gap-2">
          {
            toc.slice(0, 8).map((c) => (
              <a
                href={L(c.path)}
                class="rounded-lg border border-[var(--border)] bg-[var(--bg-elevated)] px-2.5 py-1 text-[12.5px] text-[var(--text-muted)] transition-colors hover:border-[var(--border-strong)] hover:text-[var(--text)]"
              >
                <span class="mr-1 font-mono text-[11px] text-[var(--text-faint)]">{c.num}</span>
                {c.title}
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ── 进度 ─────────────────────────────────────────── -->
    <section class="mb-14">
      <div class="flex flex-wrap items-baseline gap-x-8 gap-y-3 rounded-xl border border-[var(--border)] px-5 py-4">
        <div>
          <p class="font-mono text-[22px] tabular-nums text-[var(--text)]" id="ql-my-progress">—</p>
          <p class="text-[12px] text-[var(--text-faint)]" id="ql-my-progress-note">
            {t('你的学习进度只存在本机浏览器里')}
          </p>
        </div>
        <div>
          <p class="font-mono text-[22px] tabular-nums text-[var(--text)]">{sceneCount}</p>
          <p class="text-[12px] text-[var(--text-faint)]">{t('个 3D 场景')}</p>
        </div>
        <div>
          <p class="font-mono text-[22px] tabular-nums text-[var(--text)]">{modules.length}</p>
          <p class="text-[12px] text-[var(--text-faint)]">{t('个模块')}</p>
        </div>
        <div>
          <p class="font-mono text-[22px] tabular-nums text-[var(--text)]">{allSections.length}</p>
          <p class="text-[12px] text-[var(--text-faint)]">{t('节教材')}</p>
        </div>
      </div>
    </section>

    <footer class="border-t border-[var(--border)] pt-6 text-[13px] leading-relaxed text-[var(--text-faint)]">
      <p>
        {
          t(
            '本站为纯静态站点，所有计算在本地浏览器中完成。学习进度保存在本机 localStorage 中，不会上传。访问过的页面会被缓存，可离线浏览。',
          )
        }
      </p>
    </footer>
  </div>
</BaseLayout>

<script>
  import { lastVisited, loadProgress, summarise, MASTERY_LABEL } from '@/lib/progress'

  // 索引里带了每节/每个模块的标题，用来把「继续上次」显示成人话
  type IndexDoc = { id: string; href: string; label: string; title: string }

  async function hydrate() {
    const state = loadProgress()
    const ids = Object.keys(state)
    if (!ids.length) return

    let docs: IndexDoc[] = []
    try {
      const res = await fetch(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/search-index.json`)
      docs = (await res.json()) as IndexDoc[]
    } catch {
      return
    }

    // 中英两份文档共用同一个 id（进度与语言无关），统计前先去重
    const uniqueIds = [...new Set(docs.map((d) => d.id))]
    const { read, mastered, total } = summarise(uniqueIds)
    const value = document.getElementById('ql-my-progress')
    const note = document.getElementById('ql-my-progress-note')
    if (value) value.textContent = `${read}/${total}`
    if (note) note.textContent = `其中 ${mastered} 处自评为「${MASTERY_LABEL[2]}」以上`

    const last = lastVisited()
    const isEn = document.documentElement.lang.startsWith('en')
    const candidates = last ? docs.filter((d) => d.id === last.id) : []
    const doc =
      candidates.find((d) => d.href.includes('/en/') === isEn) ?? candidates[0]
    if (doc) {
      const box = document.getElementById('ql-resume')
      const link = box?.querySelector<HTMLAnchorElement>('[data-resume-link]')
      const label = box?.querySelector<HTMLElement>('[data-resume-label]')
      if (box && link && label) {
        link.href = doc.href
        label.textContent = doc.label ? `${doc.label} ${doc.title}` : doc.title
        box.classList.remove('hidden')
      }
    }
  }

  void hydrate()
</script>
