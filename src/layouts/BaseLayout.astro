---
import '@/styles/global.css'
import Sidebar from '@/components/layout/Sidebar.astro'
import Footer from '@/components/layout/Footer.astro'
import SearchDialog from '@/components/search/SearchDialog'
import FormulaPanel from '@/components/ui/FormulaPanel.astro'
import { translator, localePath, HTML_LANG, DEFAULT_LANG, type Lang } from '@/i18n'

interface Props {
  title: string
  description?: string
  currentId?: string
  currentChapter?: string
  /** 首页等宽屏页面可以关掉侧栏 */
  sidebar?: boolean
  lang?: Lang
}

const {
  title,
  currentId,
  currentChapter,
  sidebar = true,
  lang = DEFAULT_LANG,
} = Astro.props

const t = translator(lang)
const description =
  Astro.props.description ??
  t('从零基础到前沿的量子力学系统教程，以 3D 交互场景为主讲。')

const base = import.meta.env.BASE_URL
const L = (p: string) => localePath(lang, p, base)

/**
 * 语言切换：把当前路径在两种语言之间对折。
 * 中文在根路径，英文在 /en/ 下，所以只需要加上或去掉一个前缀——
 * 用户停在哪个模块，切过去还是那个模块。
 */
const here = Astro.url.pathname
const rel = here.slice(base.length).replace(/^\/+/, '')
const relNoLang = rel.startsWith('en/') ? rel.slice(3) : rel === 'en' ? '' : rel
const otherLang: Lang = lang === 'zh' ? 'en' : 'zh'
const otherHref = localePath(otherLang, relNoLang, base)
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {t('量子力学阶梯')}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}icon-192.png`} />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <meta name="theme-color" content="#3b5bdb" />
    <meta name="color-scheme" content="light dark" />
    <slot name="head" />

    <script is:inline>
      // 必须在首帧前定好主题，否则深色模式用户会被闪一下白屏。
      // 这段是内联的，不走打包，不受网络影响。
      ;(function () {
        try {
          var stored = localStorage.getItem('ql:theme')
          var system = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
          document.documentElement.dataset.theme = stored === 'light' || stored === 'dark' ? stored : system
        } catch (e) {
          document.documentElement.dataset.theme = 'light'
        }
      })()
    </script>
  </head>

  <body class="min-h-screen bg-[var(--bg)]" data-section-id={currentId}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-lg focus:bg-[var(--bg-elevated)] focus:px-3 focus:py-2 focus:shadow-lg"
    >
      {t('跳到正文')}
    </a>

    <header
      class="no-print sticky top-0 z-30 border-b border-[var(--border)] bg-[color-mix(in_srgb,var(--bg)_88%,transparent)] backdrop-blur-md"
    >
      <div class="flex h-14 items-center gap-3 px-4">
        {
          sidebar && (
            <button
              type="button"
              id="ql-sidebar-toggle"
              aria-label={t('打开目录')}
              aria-expanded="false"
              class="-ml-1 rounded-lg p-2 text-[var(--text-muted)] hover:bg-[var(--bg-subtle)] lg:hidden"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 6h18M3 12h18M3 18h18" />
              </svg>
            </button>
          )
        }

        <a href={L('')} class="flex shrink-0 items-center gap-2 font-semibold tracking-tight">
          <span
            class="grid size-7 place-items-center rounded-md bg-[var(--accent)] font-mono text-[13px] text-white"
            aria-hidden="true">ψ</span
          >
          <span class="hidden text-[15px] sm:inline">{t('量子力学阶梯')}</span>
        </a>

        <div class="flex-1"></div>

        <button
          type="button"
          data-search-open
          class="flex items-center gap-2 rounded-lg border border-[var(--border)] bg-[var(--bg-elevated)] py-1.5 pr-2 pl-3 text-[13px] text-[var(--text-faint)] transition-colors hover:border-[var(--border-strong)]"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.5-3.5"></path>
          </svg>
          <span class="hidden sm:inline">{t('搜索')}</span>
          <kbd
            class="hidden rounded border border-[var(--border)] bg-[var(--bg-subtle)] px-1.5 font-mono text-[11px] sm:inline"
            >/</kbd
          >
        </button>

        <button
          type="button"
          data-formula-open
          title={t('公式速查（快捷键 f）')}
          aria-label={t('公式速查')}
          class="rounded-lg p-2 text-[var(--text-muted)] transition-colors hover:bg-[var(--bg-subtle)]"
        >
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 4h16M9 4v16M4 12h10"></path>
          </svg>
        </button>

        <a
          href={otherHref}
          hreflang={otherLang === 'zh' ? 'zh-CN' : 'en'}
          title={t('切换语言')}
          class="rounded-lg px-2 py-1.5 font-mono text-[12px] text-[var(--text-muted)] transition-colors hover:bg-[var(--bg-subtle)] hover:text-[var(--text)]"
        >
          {otherLang === 'en' ? 'EN' : '中'}
        </a>

        <button
          type="button"
          id="ql-theme-toggle"
          title={t('切换深浅色（快捷键 t）')}
          aria-label={t('切换深浅色主题')}
          class="rounded-lg p-2 text-[var(--text-muted)] transition-colors hover:bg-[var(--bg-subtle)]"
        >
          <svg
            class="hidden dark:block"
            width="17"
            height="17"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
            ></path>
          </svg>
          <svg
            class="block dark:hidden"
            width="17"
            height="17"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
          </svg>
        </button>
      </div>
    </header>

    <div class="mx-auto flex w-full max-w-[1600px]">
      {
        sidebar && (
          <>
            <div
              id="ql-sidebar-backdrop"
              class="no-print fixed inset-0 z-30 hidden bg-black/40 lg:hidden"
              aria-hidden="true"
            />
            <aside
              id="ql-sidebar"
              data-sidebar-scroll
              class="no-print fixed top-14 bottom-0 left-0 z-40 w-[280px] -translate-x-full overflow-y-auto overscroll-contain border-r border-[var(--border)] bg-[var(--bg)] px-2 py-5 transition-transform duration-200 lg:sticky lg:z-0 lg:h-[calc(100vh-3.5rem)] lg:translate-x-0"
            >
              <Sidebar currentId={currentId} currentChapter={currentChapter} lang={lang} />
            </aside>
          </>
        )
      }

      <main id="main" class="min-w-0 flex-1">
        <slot />
        <Footer lang={lang} />
      </main>
    </div>

    <SearchDialog client:idle />
    <FormulaPanel />

    <script>
      // ── 主题切换 ───────────────────────────────────────────
      const root = document.documentElement
      document.getElementById('ql-theme-toggle')?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark'
        root.dataset.theme = next
        try {
          localStorage.setItem('ql:theme', next)
        } catch {}
      })

      // ── 移动端侧栏 ─────────────────────────────────────────
      const sidebar = document.getElementById('ql-sidebar')
      const backdrop = document.getElementById('ql-sidebar-backdrop')
      const toggle = document.getElementById('ql-sidebar-toggle')

      function setSidebar(open: boolean) {
        if (!sidebar) return
        sidebar.classList.toggle('-translate-x-full', !open)
        backdrop?.classList.toggle('hidden', !open)
        toggle?.setAttribute('aria-expanded', String(open))
        document.body.style.overflow = open && window.innerWidth < 1024 ? 'hidden' : ''
      }

      toggle?.addEventListener('click', () =>
        setSidebar(sidebar?.classList.contains('-translate-x-full') ?? false),
      )
      backdrop?.addEventListener('click', () => setSidebar(false))
      sidebar?.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a') && window.innerWidth < 1024) setSidebar(false)
      })

      // ── 全局快捷键 ─────────────────────────────────────────
      // 输入框里不拦截，否则在搜索框里打 "/" 会再弹一次搜索框
      function inEditable(el: EventTarget | null) {
        const n = el as HTMLElement | null
        return !!n?.closest?.('input, textarea, select, [contenteditable="true"]')
      }

      document.addEventListener('keydown', (e) => {
        if (e.metaKey || e.ctrlKey || e.altKey) {
          if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
            e.preventDefault()
            window.dispatchEvent(new CustomEvent('ql:search-open'))
          }
          return
        }
        if (inEditable(e.target)) return

        if (e.key === '/') {
          e.preventDefault()
          window.dispatchEvent(new CustomEvent('ql:search-open'))
        } else if (e.key === 'f') {
          e.preventDefault()
          window.dispatchEvent(new CustomEvent('ql:formula-toggle'))
        } else if (e.key === 't') {
          const next = root.dataset.theme === 'dark' ? 'light' : 'dark'
          root.dataset.theme = next
          try {
            localStorage.setItem('ql:theme', next)
          } catch {}
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
          const rel = e.key === 'ArrowLeft' ? 'prev' : 'next'
          const link = document.querySelector<HTMLAnchorElement>(`link[rel="${rel}"]`)
          if (link?.href) window.location.href = link.href
        }
      })

      document.querySelectorAll('[data-search-open]').forEach((b) =>
        b.addEventListener('click', () => window.dispatchEvent(new CustomEvent('ql:search-open'))),
      )
      document.querySelectorAll('[data-formula-open]').forEach((b) =>
        b.addEventListener('click', () => window.dispatchEvent(new CustomEvent('ql:formula-toggle'))),
      )

      // ── 离线支持 ───────────────────────────────────────────
      // 只在生产构建里注册：开发时 service worker 会缓存住旧的模块，
      // 改一行代码要清一次缓存才看得到效果。
      if (import.meta.env.PROD && 'serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker
            .register(`${import.meta.env.BASE_URL}sw.js`, { scope: import.meta.env.BASE_URL })
            .catch(() => {
              // 用 file:// 打开、或浏览器禁用了 SW：站点本身照常工作，只是没有离线能力
            })
        })
      }

      // 打印前展开全部推导，免得打印稿里只剩标题
      window.addEventListener('beforeprint', () => {
        document.querySelectorAll('details').forEach((d) => {
          if (!d.open) {
            d.dataset.wasClosed = '1'
            d.open = true
          }
        })
      })
      window.addEventListener('afterprint', () => {
        document.querySelectorAll<HTMLDetailsElement>('details[data-was-closed]').forEach((d) => {
          d.open = false
          delete d.dataset.wasClosed
        })
      })
    </script>
  </body>
</html>
